{% if __platform_operator_groups.resources | length == 0 %}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: {{ openshift_ansible_platform_operator_group_name }}
  namespace: {{ openshift_ansible_platform_operator_namespace }}
spec:
  targetNamespaces:
    - {{ openshift_ansible_platform_operator_namespace }}
{% endif %}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: {{ openshift_ansible_platform_operator_subscription_name }}
  namespace: {{ openshift_ansible_platform_operator_namespace }}
spec:
  name: {{ openshift_ansible_platform_operator_package }}
  channel: {{ openshift_ansible_platform_operator_channel }}
  source: {{ openshift_ansible_platform_operator_source }}
  sourceNamespace: {{ openshift_ansible_platform_operator_source_namespace }}
  installPlanApproval: {{ openshift_ansible_platform_operator_approval }}
