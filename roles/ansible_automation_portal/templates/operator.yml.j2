---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ansible_automation_portal_namespace }}
{% if __portal_operator_namespace != ansible_automation_portal_namespace %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ __portal_operator_namespace }}
{% endif %}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: automation-portal-operator
  namespace: {{ __portal_operator_namespace }}
spec:
  targetNamespaces:
    - {{ ansible_automation_portal_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: automation-portal-operator
  namespace: {{ __portal_operator_namespace }}
spec:
  name: automation-portal-operator
  channel: {{ ansible_automation_portal_operator_channel }}
  source: {{ ansible_automation_portal_operator_source }}
  sourceNamespace: openshift-marketplace
  installPlanApproval: {{ ansible_automation_portal_operator_approval }}
