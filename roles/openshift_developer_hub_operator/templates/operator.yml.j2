{% if __developer_hub_operator_groups.resources | length == 0 %}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: {{ openshift_developer_hub_operator_namespace }}
  namespace: {{ openshift_developer_hub_operator_namespace }}
spec: {}   # empty spec = All namespaces (the only install mode the operator supports)
{% endif %}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: {{ openshift_developer_hub_operator_subscription_name }}
  namespace: {{ openshift_developer_hub_operator_namespace }}
spec:
  name: {{ openshift_developer_hub_operator_package }}
  channel: {{ openshift_developer_hub_operator_channel }}
  source: {{ openshift_developer_hub_operator_source }}
  sourceNamespace: openshift-marketplace
  installPlanApproval: {{ openshift_developer_hub_operator_approval }}
