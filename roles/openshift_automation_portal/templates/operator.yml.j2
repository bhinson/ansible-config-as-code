---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ openshift_automation_portal_namespace }}
{% if __portal_operator_namespace != openshift_automation_portal_namespace %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ __portal_operator_namespace }}
{% endif %}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: automation-portal-operator
  namespace: {{ __portal_operator_namespace }}
spec:
  targetNamespaces:
    - {{ openshift_automation_portal_namespace }}
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: automation-portal-operator
  namespace: {{ __portal_operator_namespace }}
spec:
  name: automation-portal-operator
  channel: {{ openshift_automation_portal_operator_channel }}
  source: {{ openshift_automation_portal_operator_source }}
  sourceNamespace: openshift-marketplace
  installPlanApproval: {{ openshift_automation_portal_operator_approval }}
