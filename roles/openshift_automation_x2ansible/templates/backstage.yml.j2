---
# Backstage spec (upstream deploy/app.yaml; RHDH 1.10 operator). The pod runs as x2a-sa so the x2a backend can create
# Jobs; NODE_EXTRA_CA_CERTS adds the cluster root and AAP certificate authorities.
application:
  appConfig:
    mountPath: /opt/app-root/src
    configMaps:
      - name: {{ openshift_automation_x2ansible_name }}-app-config
  dynamicPluginsConfigMapName: {{ openshift_automation_x2ansible_name }}-dynamic-plugins
  extraEnvs:
    secrets:
      - name: {{ openshift_automation_x2ansible_name }}-secrets
  route:
    enabled: true
{% if openshift_automation_x2ansible_route_host | default('', true) | length > 0 %}
    host: {{ openshift_automation_x2ansible_route_host }}
{% endif %}
# Developer Lightspeed preset is on by default in RHDH 1.10 and needs its own LLM setup
flavours:
  - name: lightspeed
    enabled: false
database:
  enableLocalDb: true
deployment:
  patch:
    spec:
      template:
        metadata:
          annotations:
            x2ansible.ansible-config-as-code/config-checksum: {{ __x2ansible_config_checksum }}
        spec:
          serviceAccountName: x2a-sa
          automountServiceAccountToken: true
          containers:
            - name: backstage-backend
{% if __x2ansible_small %}
              resources: {{ openshift_automation_x2ansible_resources.small.backstage | to_json }}
{% endif %}
              env:
                - name: NODE_EXTRA_CA_CERTS
                  value: /etc/pki/tls/custom-ca/ca-bundle.crt
              volumeMounts:
                - name: custom-ca-bundle
                  mountPath: /etc/pki/tls/custom-ca
                  readOnly: true
          volumes:
            - name: custom-ca-bundle
              configMap:
                name: {{ openshift_automation_x2ansible_name }}-ca-bundle
