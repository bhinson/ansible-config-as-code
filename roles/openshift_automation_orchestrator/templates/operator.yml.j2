---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ openshift_automation_orchestrator_operator_namespace }}
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: automation-orchestrator-operator
  namespace: {{ openshift_automation_orchestrator_operator_namespace }}
spec: {}   # empty spec = AllNamespaces (the only install mode this operator supports)
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: automation-orchestrator-operator
  namespace: {{ openshift_automation_orchestrator_operator_namespace }}
spec:
  name: automation-orchestrator-operator
  channel: {{ openshift_automation_orchestrator_operator_channel }}
  source: {{ openshift_automation_orchestrator_operator_source }}
  sourceNamespace: openshift-marketplace
  installPlanApproval: {{ openshift_automation_orchestrator_operator_approval }}
